# Docker Compose deployment settings for akamai-siem (NON-SECRET only).
# Copy to .env, edit the values, then:
#   docker compose --env-file .env up -d --build
#
# Credential paths point at host files that already exist. Their contents are
# never stored in this file, the image, or the environment — they are mounted
# read-only as Docker secrets.

# --- Akamai SIEM ---
# Your Akamai SIEM configuration ID.
AKAMAI_CONFIG_ID=replace-me
# EdgeGrid credential section to use.
AKAMAI_SECTION=siem
# Absolute host path to your .edgerc file (SIEM read access, chmod 600).
AKAMAI_EDGERC_FILE=/absolute/path/to/.edgerc

# --- Coralogix ---
# Ingress domain for your region, e.g. ap3.coralogix.com.
CORALOGIX_DOMAIN=replace-region.coralogix.com
# Application / subsystem the Akamai WAF extension is deployed against.
# Intended live target for this deployment: application akamai, subsystem 75581.
CORALOGIX_APPLICATION=akamai
CORALOGIX_SUBSYSTEM=75581
# Absolute host path to the Coralogix key JSON (contains apiKey.keyValue).
CORALOGIX_KEY_FILE=/absolute/path/to/coralogix-key.json

# --- Loop timing ---
# Seconds between pull+send cycles.
POLL_INTERVAL=600
# Seconds to wait after a pull/send failure before retrying.
RETRY_DELAY=30
# Maximum records per Coralogix /singles request.
SEND_BATCH_SIZE=100